                    "value": "{\n  \"id\": \"tok_4VpPvSNJUHn723embBWuAgoK\",\n  \"object\": \"token\",\n  \"card\": {\n    \"id\": \"card_Yi1lfqAk7twr8Be3hTPg0Fv4\",\n    \"object\": \"card\",\n    \"address\": {},\n    \"customer\": \"cst_sdsbd7tsd977\",\n    \"funding\": \"CREDIT\",\n    \"fingerprint\": \"t9g/phBxZ9ZR6JgHBZ8ty2Yfy\",\n    \"brand\": \"AMEX\",\n    \"exp_month\": 12,\n    \"exp_year\": 2019,\n    \"last_four\": \"0005\",\n    \"first_six\": \"378282\",\n    \"name\": \"test user\"\n  },\n  \"client_ip\": \"127.0.0.1\",\n  \"created\": 1533728879,\n  \"live_mode\": false,\n  \"type\": \"CARD\",\n  \"used\": false\n}"
